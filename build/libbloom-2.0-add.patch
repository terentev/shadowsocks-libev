diff --git a/bloom.c b/bloom.c
index cb9f914..324456f 100644
--- a/bloom.c
+++ b/bloom.c
@@ -139,0 +140,9 @@ int bloom_check(struct bloom * bloom, const void * buffer, int len)
+/* The next position is (position + stride) % bits. */
+static inline unsigned long next_position(unsigned long position,
+                                          unsigned long stride,
+                                          unsigned long bits)
+{
+  return position >= bits - stride ? position - (bits - stride)
+                                   : position + stride;
+}
+
@@ -142 +151,47 @@ int bloom_add(struct bloom * bloom, const void * buffer, int len)
-  return bloom_check_add(bloom, buffer, len, 1);
+  if (!bloom->ready || bloom->hashes == 0) {
+    return bloom_check_add(bloom, buffer, len, 1);
+  }
+
+  const unsigned long bits = bloom->bits;
+  const unsigned int a = murmurhash2(buffer, len, 0x9747b28c);
+  const unsigned long stride = murmurhash2(buffer, len, a) % bits;
+  unsigned long position = a % bits;
+  unsigned int hits = 0;
+
+  for (unsigned int i = 0; i < bloom->hashes; i++) {
+    hits += test_bit_set_bit(bloom->bf, position, 1);
+    position = next_position(position, stride, bits);
+  }
+
+  return hits == bloom->hashes;
+}
+
+
+int bloom_insert(struct bloom * bloom, const void * buffer, int len)
+{
+  if (!bloom->ready || bloom->hashes == 0) {
+    return bloom_add(bloom, buffer, len);
+  }
+
+  const unsigned long bits = bloom->bits;
+  const unsigned int a = murmurhash2(buffer, len, 0x9747b28c);
+  const unsigned long stride = murmurhash2(buffer, len, a) % bits;
+  unsigned long position = a % bits;
+
+  const unsigned int hashes = bloom->hashes;
+  unsigned char * const bitmap = bloom->bf;
+  unsigned long second = next_position(position, stride, bits);
+  const unsigned long pair_stride = next_position(stride, stride, bits);
+
+  /* Advance the even and odd positions independently by two steps. */
+  for (unsigned int pairs = hashes / 2; pairs != 0; pairs--) {
+    bitmap[position >> 3] |= (unsigned char)(1U << (position & 7U));
+    bitmap[second >> 3] |= (unsigned char)(1U << (second & 7U));
+    position = next_position(position, pair_stride, bits);
+    second = next_position(second, pair_stride, bits);
+  }
+  if (hashes % 2 != 0) {
+    bitmap[position >> 3] |= (unsigned char)(1U << (position & 7U));
+  }
+
+  return 0;
