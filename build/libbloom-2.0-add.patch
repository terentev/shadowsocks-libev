diff --git a/bloom.c b/bloom.c
index cb9f914..cdc6c3c 100644
--- a/bloom.c
+++ b/bloom.c
@@ -48,2 +48,9 @@ inline static int test_bit_set_bit(unsigned char * buf,
-static int bloom_check_add(struct bloom * bloom,
-                           const void * buffer, int len, int add)
+struct bloom_hash bloom_hash_buffer(const void *buffer, int len)
+{
+  struct bloom_hash hash;
+  hash.a = murmurhash2(buffer, len, 0x9747b28c);
+  hash.b = murmurhash2(buffer, len, hash.a);
+  return hash;
+}
+
+static int bloom_check_add_hash(struct bloom * bloom, struct bloom_hash hash, int add)
@@ -57,2 +63,0 @@ static int bloom_check_add(struct bloom * bloom,
-  unsigned int a = murmurhash2(buffer, len, 0x9747b28c);
-  unsigned int b = murmurhash2(buffer, len, a);
@@ -63 +68 @@ static int bloom_check_add(struct bloom * bloom,
-    x = (a + b*i) % bloom->bits;
+    x = (hash.a + hash.b * i) % bloom->bits;
@@ -79,0 +85,16 @@ static int bloom_check_add(struct bloom * bloom,
+static int bloom_check_add(struct bloom * bloom,
+                           const void * buffer, int len, int add)
+{
+  struct bloom_hash hash = {0};
+  if (bloom->ready) {
+    hash = bloom_hash_buffer(buffer, len);
+  }
+  return bloom_check_add_hash(bloom, hash, add);
+}
+
+int bloom_check_hash(struct bloom *bloom, struct bloom_hash hash)
+{
+  return bloom_check_add_hash(bloom, hash, 0);
+}
+
+
@@ -139,0 +161,9 @@ int bloom_check(struct bloom * bloom, const void * buffer, int len)
+/* The next position is (position + stride) % bits. */
+static inline unsigned long next_position(unsigned long position,
+                                          unsigned long stride,
+                                          unsigned long bits)
+{
+  return position >= bits - stride ? position - (bits - stride)
+                                   : position + stride;
+}
+
@@ -142 +172,58 @@ int bloom_add(struct bloom * bloom, const void * buffer, int len)
-  return bloom_check_add(bloom, buffer, len, 1);
+  if (!bloom->ready || bloom->hashes == 0) {
+    return bloom_check_add(bloom, buffer, len, 1);
+  }
+
+  const unsigned long bits = bloom->bits;
+  const unsigned int a = murmurhash2(buffer, len, 0x9747b28c);
+  const unsigned long stride = murmurhash2(buffer, len, a) % bits;
+  unsigned long position = a % bits;
+  unsigned int hits = 0;
+
+  for (unsigned int i = 0; i < bloom->hashes; i++) {
+    hits += test_bit_set_bit(bloom->bf, position, 1);
+    position = next_position(position, stride, bits);
+  }
+
+  return hits == bloom->hashes;
+}
+
+
+static inline int bloom_insert_positions(struct bloom *bloom, struct bloom_hash hash)
+{
+  const unsigned long bits = bloom->bits;
+  const unsigned long stride = hash.b % bits;
+  unsigned long position = hash.a % bits;
+
+  const unsigned int hashes = bloom->hashes;
+  unsigned char * const bitmap = bloom->bf;
+  unsigned long second = next_position(position, stride, bits);
+  const unsigned long pair_stride = next_position(stride, stride, bits);
+
+  /* Advance the even and odd positions independently by two steps. */
+  for (unsigned int pairs = hashes / 2; pairs != 0; pairs--) {
+    bitmap[position >> 3] |= (unsigned char)(1U << (position & 7U));
+    bitmap[second >> 3] |= (unsigned char)(1U << (second & 7U));
+    position = next_position(position, pair_stride, bits);
+    second = next_position(second, pair_stride, bits);
+  }
+  if (hashes % 2 != 0) {
+    bitmap[position >> 3] |= (unsigned char)(1U << (position & 7U));
+  }
+
+  return 0;
+}
+
+int bloom_insert(struct bloom *bloom, const void *buffer, int len)
+{
+  if (!bloom->ready || bloom->hashes == 0) {
+    return bloom_add(bloom, buffer, len);
+  }
+  return bloom_insert_positions(bloom, bloom_hash_buffer(buffer, len));
+}
+
+int bloom_insert_hash(struct bloom *bloom, struct bloom_hash hash)
+{
+  if (!bloom->ready || bloom->hashes == 0) {
+    return bloom_check_add_hash(bloom, hash, 1);
+  }
+  return bloom_insert_positions(bloom, hash);
diff --git a/bloom.h b/bloom.h
index 3d7b86b..71a2486 100644
--- a/bloom.h
+++ b/bloom.h
@@ -128,0 +129,12 @@ int bloom_add(struct bloom * bloom, const void * buffer, int len);
+/* Set the same bits as bloom_add without reporting prior membership. */
+int bloom_insert(struct bloom * bloom, const void * buffer, int len);
+
+/* Reuse the same hashes for checks and insertion of one value. */
+struct bloom_hash {
+  unsigned int a;
+  unsigned int b;
+};
+struct bloom_hash bloom_hash_buffer(const void *buffer, int len);
+int bloom_check_hash(struct bloom *bloom, struct bloom_hash hash);
+int bloom_insert_hash(struct bloom *bloom, struct bloom_hash hash);
+
