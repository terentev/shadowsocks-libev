From f051802ac8816cd6cbb46404519547bacf0dce0b Mon Sep 17 00:00:00 2001
From: Aron Xu <aron@debian.org>
Date: Wed, 12 Feb 2025 01:17:04 +0800
Subject: [PATCH] Enable IP_BIND_ADDRESS_NO_PORT for outgoing connections

This is a Linux only feature supported since 4.2, enabled it if
supported.

https://github.com/shadowsocks/shadowsocks-libev/issues/2930
---
 src/server.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/server.c b/src/server.c
index 73b6599..7f5c39f 100644
--- a/src/server.c
+++ b/src/server.c
@@ -733,6 +733,14 @@ connect_to_remote(EV_P_ struct addrinfo *res,
     }
 #endif
 
+#ifdef IP_BIND_ADDRESS_NO_PORT
+    int bind_address_no_port = 1;
+    if (setsockopt(sockfd, IPPROTO_IP, IP_BIND_ADDRESS_NO_PORT,
+            &bind_address_no_port, sizeof(int)) != 0) {
+        ERROR("setsockopt: IP_BIND_ADDRESS_NO_PORT");
+    }
+#endif
+
     remote_t *remote = new_remote(sockfd);
 
     if (fast_open) {
-- 
2.39.5

